{
  "name": "paullevitt-dev",
  "version": "1.0.0",
  "description": "My personal portfolio site",
  "private": true,
  "type": "module",
  "source": [
    "src/index.html",
    "src/about/index.html",
    "src/projects/index.html"
  ],  
  "scripts": {
    "start": "npm run dev",
    "dev": "parcel --port 3000 --open",
    "build": "parcel build --no-source-maps && cp -R static/. dist/",
    "clean": "rm -rf dist .parcel-cache",
    "rebuild": "npm run clean && npm run build",
    "serve": "npx --yes serve dist"
  },
  "devDependencies": {
    "@parcel/packager-raw-url": "^2.16.4",
    "@parcel/transformer-jsonld": "^2.16.4",
    "@parcel/transformer-webmanifest": "^2.16.4",
    "parcel": "^2.12.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "not dead"
  ],
  "engines": {
    "node": ">=20"
  }
}
