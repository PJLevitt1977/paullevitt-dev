    "jobTitle": "Technical Architect",
    "email": "mailto:hello@paullevitt.dev",
    "url": "https://paullevitt.dev/",
    "address": { "@type": "PostalAddress", "addressLocality": "Brooklyn", "addressRegion": "NY", "addressCountry": "US" },
    "alumniOf": { "@type": "CollegeOrUniversity", "name": "University of the West of England, Bristol" },
    "knowsAbout": ["Software architecture", "Domain-specific languages", "Internationalization", "Node.js", "Distributed systems"],
    "sameAs": ["https://www.linkedin.com/in/paullevitt-dev", "https://github.com/PJLevitt1977"]
  }
  </script>
</head>

<body>
  <!-- <a class="skip-link" href="#main">Skip to content</a> -->

