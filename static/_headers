/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/projects/wall-planner/*
  Content-Security-Policy: default-src 'unsafe-inline'; img-src 'unsafe-inline' data:; style-src 'unsafe-inline'; script-src 'unsafe-inline'; font-src 'unsafe-inline'; base-uri 'unsafe-inline'; form-action 'unsafe-inline'; frame-ancestors 'none'